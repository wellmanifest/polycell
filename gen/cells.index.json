    "urn:wm:cell:shop:shipping.cost:v1": {
      "name": "shipping.cost",
      "owner": "python",
      "contract": "e41ae88b5509",
      "persist": null,
      "nl": {
        "pl": [
          "shipping cost"
        ],
        "en": [
          "shipping cost"
        ]
      },
      "menu": {
        "category": "Legacy",
        "label": "shipping_cost",
        "interactionType": "modal_form"
      },
      "summary": "Shipping cost is a fixed rate, not a per-kilogram multiplication. For country PL: weight_kg <= 5 costs 9.99, otherwise 19.99. For EVERY other country: weight_kg <= 5 costs 29.99, otherwise 49.99.",
      "examples": [
        {
          "name": "pl_light",
          "input": {
            "weight_kg": 3,
            "country": "PL"
          },
          "output": {
            "result": 9.99
          }
        },
        {
          "name": "pl_boundary",
          "input": {
            "weight_kg": 5,
            "country": "PL"
          },
          "output": {
            "result": 9.99
          }
        },
        {
          "name": "pl_over_boundary",
          "input": {
            "weight_kg": 5.001,
            "country": "PL"
          },
          "output": {
            "result": 19.99
          }
        },
        {
          "name": "other_boundary",
          "input": {
            "weight_kg": 5,
            "country": "FR"
          },
          "output": {
            "result": 29.99
          }
        },
        {
          "name": "other_over_boundary",
          "input": {
            "weight_kg": 5.001,
            "country": "FR"
          },
          "output": {
            "result": 49.99
          }
        }
      ],
      "input": {
        "weight_kg": {
          "base": "double",
          "is_list": false,
          "optional": false
        },
        "country": {
          "base": "string",
          "is_list": false,
          "optional": false
        }
      },
      "output": {
        "result": {
          "base": "double",
          "is_list": false,
          "optional": false
        }
      }
    }
  },
  "processes": {
    "checkout": {
      "schema": "poa.process/v1",
      "process_ref": "poa://shop.local/process/checkout/v1",
      "title": "Checkout - walidacja klienta, wycena, powiadomienie",
      "owner": "service:gateway",
      "input": {
        "customer": {
          "name": "string",
          "email": "string",
          "country": "string"
        },
        "cart": {
          "items": "LineItem[]",
          "currency": "string",
          "coupon": "string?"
        },
        "lang": "string"
      },
      "steps": [
        {
          "id": "validate",
          "capability_ref": "urn:wm:cell:shop:customer.validate:v1",
          "kind": "query",
          "effects": [
            "read_data"
          ],
          "depends_on": [],
          "input": {
            "name": "$.customer.name",
            "email": "$.customer.email",
            "country": "$.customer.country"
          },
          "guard": "$.steps.validate.valid == true"
        },
        {
          "id": "quote",
          "capability_ref": "urn:wm:cell:shop:pricing.quote:v1",
          "kind": "query",
          "effects": [
            "read_data"
          ],
          "depends_on": [
            "validate"
          ],
          "input": {
            "items": "$.cart.items",
            "currency": "$.cart.currency",
            "coupon": "$.cart.coupon"
          }
        },
        {
          "id": "notify",
          "capability_ref": "urn:wm:cell:shop:notify.render:v1",
          "kind": "command",
          "effects": [
            "local_write"
          ],
          "depends_on": [
            "quote"
          ],
          "input": {
            "customer_name": "$.customer.name",
            "total": "$.steps.quote.total",
            "currency": "$.steps.quote.currency",
            "lang": "$.lang"
          }
        }
      ],
      "output": {
        "customer": "$.steps.validate",
        "quote": "$.steps.quote",
        "message": "$.steps.notify"
      },
      "examples": [
        {
          "name": "happy",
          "input": {
            "customer": {
              "name": "Jan",
              "email": "JAN@EXAMPLE.COM",
              "country": "pl"
            },
            "cart": {
              "items": [
                {
                  "sku": "A1",
                  "qty": 2,
                  "unit_price": 50.0
                },
                {
                  "sku": "B2",
                  "qty": 1,
                  "unit_price": 100.0
                }
              ],
              "currency": "PLN",
              "coupon": "AI10"
            },
            "lang": "pl"
          },
          "expect": {
            "quote.total": 221.4,
            "message.subject": "Potwierdzenie zamówienia: 221.40 PLN"
          }
        }
      ]
    }
  }
}
