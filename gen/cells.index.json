{
  "cells": {
    "urn:wm:cell:shop:customer.validate:v1": {
      "name": "customer.validate",
      "owner": "python",
      "contract": "021800618efc",
      "persist": "customer_checks",
      "nl": {
        "pl": [
          "sprawdź klienta",
          "waliduj email",
          "zweryfikuj klienta"
        ],
        "en": [
          "validate customer",
          "check email"
        ]
      },
      "menu": {
        "category": "Klienci",
        "label": "Sprawdź klienta",
        "icon": "user-check",
        "interactionType": "modal_form"
      },
      "summary": "Waliduje i normalizuje dane klienta",
      "examples": [
        {
          "name": "ok",
          "input": {
            "name": "Jan Kowalski",
            "email": "  Jan.Kowalski@Example.COM ",
            "country": "pl"
          },
          "output": {
            "valid": true,
            "errors": [],
            "normalized_email": "jan.kowalski@example.com",
            "country": "PL"
          }
        },
        {
          "name": "bad",
          "input": {
            "name": "",
            "email": "nope",
            "country": "PLN"
          },
          "output": {
            "valid": false,
            "errors": [
              "name_required",
              "email_invalid",
              "country_invalid"
            ],
            "normalized_email": "nope",
            "country": "PLN"
          }
        }
      ],
      "input": {
        "name": {
          "base": "string",
          "is_list": false,
          "optional": false
        },
        "email": {
          "base": "string",
          "is_list": false,
          "optional": false
        },
        "country": {
          "base": "string",
          "is_list": false,
          "optional": false
        }
      },
      "output": {
        "valid": {
          "base": "bool",
          "is_list": false,
          "optional": false
        },
        "errors": {
          "base": "string",
          "is_list": true,
          "optional": false
        },
        "normalized_email": {
          "base": "string",
          "is_list": false,
          "optional": false
        },
        "country": {
          "base": "string",
          "is_list": false,
          "optional": false
        }
      }
    },
