{
  "schema": "wellmanifest.api-registry/v1",
  "version": "0.1.0",
  "metadata": {
    "title": "Polycell example registry",
    "description": "GENERATED by tools/polycell/gen.py - DO NOT EDIT (edit contracts/ instead)"
  },
  "services": [
    {
      "id": "gateway",
      "name": "Polycell Gateway (REST/NL/MCP/proces POA)",
      "protocol": "rest",
      "baseUrl": "http://127.0.0.1:8080",
      "defaultPort": 8080
    },
    {
      "id": "host-python",
      "name": "Cell host Python",
      "protocol": "grpc",
      "baseUrl": "grpc://127.0.0.1:9101",
      "defaultPort": 9101
    },
    {
      "id": "host-ts",
      "name": "Cell host TypeScript",
      "protocol": "grpc",
      "baseUrl": "grpc://127.0.0.1:9102",
      "defaultPort": 9102
    },
    {
      "id": "host-rust",
      "name": "Cell host Rust",
      "protocol": "grpc",
      "baseUrl": "grpc://127.0.0.1:9103",
      "defaultPort": 9103
    }
  ],
  "endpoints": [
    {
      "id": "customer.validate",
      "service": "gateway",
      "protocol": "rest",
      "title": "Waliduje i normalizuje dane klienta",
      "description": "urn:wm:cell:shop:customer.validate:v1 (owner=python)",
      "readOnly": true,
      "roles": [
        "dev",
        "agent"
      ],
      "tags": [
        "shop",
        "python"
      ],
      "rest": {
        "method": "POST",
        "path": "/api/cells/customer.validate",
        "contentType": "application/json"
      },
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "location": "body",
          "required": true
        },
        {
          "name": "email",
          "type": "string",
          "location": "body",
          "required": true
        },
        {
          "name": "country",
          "type": "string",
          "location": "body",
          "required": true
        }
      ],
      "nlIntents": [
        {
          "lang": "pl",
          "phrases": [
            "sprawdź klienta",
            "waliduj email",
            "zweryfikuj klienta"
          ]
        },
        {
          "lang": "en",
          "phrases": [
            "validate customer",
            "check email"
          ]
        }
      ],
      "menuBinding": {
        "category": "Klienci",
        "label": "Sprawdź klienta",
        "icon": "user-check",
        "interactionType": "modal_form",
        "viewRoute": "/#/cells/customer.validate"
      }
    },
    {
      "id": "customer.validate.grpc",
      "service": "host-python",
      "protocol": "grpc",
      "title": "customer.validate (gRPC CellHost.Invoke)",
      "readOnly": true,
      "description": "polycell.v1.CellHost/Invoke urn=urn:wm:cell:shop:customer.validate:v1"
    },
    {
      "id": "customer.validate.mcp",
      "service": "gateway",
      "protocol": "mcp",
      "title": "MCP tool customer_validate",
      "readOnly": true
    },
    {
      "id": "notify.render",
      "service": "gateway",
      "protocol": "rest",
      "title": "Renderuje treść powiadomienia o zamówieniu (PL/EN)",
      "description": "urn:wm:cell:shop:notify.render:v1 (owner=ts)",
      "readOnly": true,
      "roles": [
        "dev",
