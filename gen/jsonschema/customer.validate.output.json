{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wm:cell:shop:customer.validate:v1:output",
  "title": "CustomerValidateOutput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "normalized_email": {
      "type": "string"
    },
    "country": {
      "type": "string"
    }
  },
  "required": [
    "valid",
    "errors",
    "normalized_email",
    "country"
  ],
  "$defs": {
    "LineItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sku": {
          "type": "string"
        },
        "qty": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "unit_price": {
          "type": "number"
        }
      },
      "required": [
        "sku",
        "qty",
        "unit_price"
      ]
    }
  }
}
