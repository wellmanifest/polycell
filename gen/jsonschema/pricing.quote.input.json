{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wm:cell:shop:pricing.quote:v1:input",
  "title": "PricingQuoteInput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LineItem"
      }
    },
    "currency": {
      "type": "string"
    },
    "coupon": {
      "type": "string"
    }
  },
  "required": [
    "items",
    "currency"
  ],
  "$defs": {
    "LineItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sku": {
          "type": "string"
        },
        "qty": {
          "type": "integer"
        },
        "unit_price": {
          "type": "number"
        }
      },
      "required": [
        "sku",
        "qty",
        "unit_price"
      ]
    }
  }
}
