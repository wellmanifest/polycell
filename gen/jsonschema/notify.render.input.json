{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wm:cell:shop:notify.render:v1#input",
  "title": "NotifyRenderInput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "customer_name": {
      "type": "string"
    },
    "total": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "lang": {
      "type": "string"
    }
  },
  "required": [
    "customer_name",
    "total",
    "currency",
    "lang"
  ],
  "$defs": {
    "LineItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sku": {
          "type": "string"
        },
        "qty": {
          "type": "integer"
        },
        "unit_price": {
          "type": "number"
        }
      },
      "required": [
        "sku",
        "qty",
        "unit_price"
      ]
    }
  }
}
