{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polycell single-implementation package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "urn", "name", "owner", "implementation", "contract", "runtime", "files"],
  "properties": {
    "schema": {"const": "wellmanifest.polycell.package/v1"},
    "urn": {"type": "string", "pattern": "^urn:wm:cell:[a-z0-9_-]+:[a-z0-9_.]+:v[0-9]+$"},
    "name": {"type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"},
    "owner": {"enum": ["python", "ts", "rust"]},
    "implementation": {"enum": ["cell.py", "cell.ts", "cell.rs"]},
    "contract": {"type": "string", "pattern": "^[a-f0-9]{12}$"},
    "runtime": {"const": "wellmanifest.polycell/v1"},
    "files": {
      "type": "object",
      "minProperties": 8,
      "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9.-]*$"},
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }
  }
}
